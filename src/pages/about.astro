---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { siteConfig } from '../config';

const { businessName, phone, siteUrl, serviceKeyword, city, cities, services } = siteConfig;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": `${siteUrl}/about/` },
  ],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": `About ${businessName}`,
  "description": `${businessName} provides residential ${serviceKeyword} in ${city}.`,
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": siteConfig.phoneE164,
  },
};
---

<BaseLayout
  title={`About Us | ${businessName}`}
  description={`${businessName} provides mowing, fertilization, weed control, and aeration for homes in Florence, Covington, Fort Thomas, Newport, and across Northern Kentucky. What we do, how a visit works, and where we go.`}
  canonicalURL={`${siteUrl}/about/`}
  schema={[breadcrumbSchema, aboutPageSchema]}
>

<section class="hero-section">
  <div class="container">
    <h1>About {businessName}</h1>
    <p class="hero-sub">Lawn care for Northern Kentucky homes.</p>
    <PhoneCTA />
  </div>
</section>

<div class="container py-6 text-center">
  <img
    src="/photos/team.jpg"
    alt="Lawn care crew with mowers and trimmers"
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">What We Do</h2>

  <p>Residential lawn care in Boone, Kenton, and Campbell counties: weekly mowing through the growing season, seasonal fertilization and weed control, and fall core aeration and overseeding.</p>

  <ul>
    {services.map((s) => (
      <li><strong>{s.title}</strong> — {s.description}</li>
    ))}
  </ul>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How It Works</h2>

  <p><strong>1. Quote.</strong> Call {phone} or send the form. Tell us roughly how big the yard is, which services you want, and anything unusual — steep slopes, gated backyards, heavy shade, or bare patches. Weekly and one-time mowing are both available, with no contract required.</p>

  <p><strong>2. Service.</strong> Mowing visits include mowing, trimming, edging, and blowing clippings off hard surfaces. Fertilizer and weed control are applied according to label directions on a seasonal schedule. Aeration and overseeding are done in fall, usually September through October.</p>

  <p><strong>3. Follow-up.</strong> If something was missed on a visit, call and it gets taken care of.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">Where We Work</h2>

  <p>Our main service areas in Boone, Kenton, and Campbell counties:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/lawn-care/${c.slug}/`}>Lawn care in {c.name}</a></li>
    ))}
  </ul>

  <p>Close by but not on the list? Call {phone} and ask — nearby towns are often fine.</p>
</div>

<!-- CTA -->
<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Ready for a Beautiful Lawn?</p>
    <p class="cta-sub">Call now for a free estimate.</p>
    <PhoneCTA />
  </div>
</section>

</BaseLayout>
